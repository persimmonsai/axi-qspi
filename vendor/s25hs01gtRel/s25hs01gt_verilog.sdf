(DELAYFILE
 (SDFVERSION "2.1")
 (DESIGN "testbench_s25hs01gt_verilog")
 (DATE "Thu June 25 16:10:28 2018")
 (VENDOR "Free Model Foundry")
 (PROGRAM "SDF timing utility(tm)")
 (VERSION "2.0.3")
 (DIVIDER /)
 (VOLTAGE)
 (PROCESS)
 (TEMPERATURE)
 (TIMESCALE 1ns)
 (CELL
  (CELLTYPE "s25hs01gt")
  (INSTANCE dut)
(DELAY (ABSOLUTE
    (COND  (rd_slow && ~ddr) && ~glitch                 (IOPATH SCK SO         (2:1.75:8) (2:1.75:8) () (2:1.75:8) () (2:1.75:8)))
    (COND  ((rd_fast1 || rd_fast) && ~ddr) && ~glitch       (IOPATH SCK SO        (2:1.75:8) (2:1.75:8) () (2:1.75:8) () (2:1.75:8)))
    (COND  (ddr) && ~glitch        (IOPATH SCK SO     (2:1.75:6) (2:1.75:6) () (2:1.75:6) () (2:1.75:6)))
    (COND  ((rd_fast1 || rd_fast || dual   || QUADIT ) && ~ddr)  && ~glitch     (IOPATH SCK SI    (2:1.75:8) (2:1.75:8) () (2:1.75:8) () (2:1.75:8)))
    (COND  (ddr) && ~glitch      (IOPATH SCK SI     (2:1.75:6) (2:1.75:6) () (2:1.75:6) () (2:1.75:6)))
    (COND  ((rd_fast1 || rd_fast || (QUADIT   || ~rd_fast1)) && ~ddr)  && ~glitch      (IOPATH SCK IO3_RESETNeg   (2:1.75:8) (2:1.75:8) () (2:1.75:8) () (2:1.75:8)))
    (COND  (ddr) &&   ~glitch      (IOPATH SCK IO3_RESETNeg   (2:1.75:6) (2:1.75:6) () (2:1.75:6) () (2:1.75:6)))
    (COND  ((rd_fast1 || rd_fast || (QUADIT   || ~rd_fast1)) && ~ddr)   && ~glitch       (IOPATH SCK WPNeg          (2:1.75:8) (2:1.75:8) () (2:1.75:8) () (2:1.75:8)))
    (COND  (ddr) && ~glitch                    (IOPATH SCK WPNeg          (2:1.75:6) (2:1.75:6) () (2:1.75:6) () (2:1.75:6)))
    (COND  CSNeg && ~rst_quad          (IOPATH CSNeg SO           () () (2:4:8)         () (2:4:8)         ()))
    (COND  CSNeg && rst_quad           (IOPATH CSNeg SO           () () (12:16:20)        () (12:16:20)        ()))
    (COND  CSNeg && ~rst_quad          (IOPATH CSNeg SI           () () (2:4:8)         () (2:4:8)         ()))
    (COND  CSNeg && rst_quad           (IOPATH CSNeg SI           () () (12:16:20)        () (12:16:20)        ()))
    (COND  CSNeg && ~rst_quad          (IOPATH CSNeg IO3_RESETNeg () () (2:4:8)         () (2:4:8)         ()))
    (COND  CSNeg && rst_quad           (IOPATH CSNeg IO3_RESETNeg () () (12:16:20)        () (12:16:20)        ()))
    (COND  CSNeg && ~rst_quad          (IOPATH CSNeg WPNeg        () () (2:4:8)         () (2:4:8)         ()))
    (COND  CSNeg && rst_quad           (IOPATH CSNeg WPNeg        () () (12:16:20)        () (12:16:20)        ()))
  ))
(TIMINGCHECK

    (SETUP (COND F51M   CSNeg )    SCK (4))
    (SETUP (COND ~F51M  CSNeg )    SCK (5))
    (SETUP SI        (COND sdro_io1_50       (posedge SCK))   (5))
    (SETUP SI        (COND sdro_io1_51       (posedge SCK))   (2))
    (SETUP SI        (COND ddro_io1          (posedge SCK))   (2))
    (SETUP SI        (COND ddro_io1          (negedge SCK))   (2))

       
    (SETUP SO        (COND sdro_quad_io0_50 (posedge SCK))   (5))
    (SETUP SO        (COND ddro_quad_io0_50 (posedge SCK))   (5))
    (SETUP SO        (COND ddro_quad_io0_50 (negedge SCK))   (5))
    (SETUP SO        (COND sdro_quad_io0_51 (posedge SCK))   (2))
    (SETUP SO        (COND ddro_quad_io0_51 (posedge SCK))   (2))
    (SETUP SO        (COND ddro_quad_io0_51 (negedge SCK))   (2))
    
    (SETUP WPNeg     (COND sdro_quad_io2_50 (posedge SCK))   (5))
    (SETUP WPNeg     (COND ddro_quad_io2_50 (posedge SCK))   (5))
    (SETUP WPNeg     (COND ddro_quad_io2_50 (negedge SCK))   (5))
    (SETUP WPNeg     (COND sdro_quad_io2_51 (posedge SCK))   (2))
    (SETUP WPNeg     (COND ddro_quad_io2_51 (posedge SCK))   (2))
    (SETUP WPNeg     (COND ddro_quad_io2_51 (negedge SCK))   (2))
    
    (SETUP IO3_RESETNeg  (COND sdro_quad_io3_50 (posedge SCK))   (5))
    (SETUP IO3_RESETNeg  (COND ddro_quad_io3_50 (posedge SCK))   (5))
    (SETUP IO3_RESETNeg  (COND ddro_quad_io3_50 (negedge SCK))   (5))
    (SETUP IO3_RESETNeg  (COND sdro_quad_io3_51 (posedge SCK))   (2))
    (SETUP IO3_RESETNeg  (COND ddro_quad_io3_51 (posedge SCK))   (2))
    (SETUP IO3_RESETNeg  (COND ddro_quad_io3_51 (negedge SCK))   (2))

    (SETUP WPNeg        CSNeg     (20))
    (SETUP RESETNeg     CSNeg     (50))

    (HOLD (COND  ~MOD      CSNeg) (posedge SCK) (4))
    (HOLD (COND   MOD      CSNeg) (posedge SCK) (6))
    
    (HOLD SI        (COND sdro_io1_50      (posedge SCK)) (5))
    (HOLD SI        (COND sdro_io1_51      (posedge SCK)) (2))
    (HOLD SI        (COND ddro_io1         (posedge SCK)) (1.2))
    (HOLD SI        (COND ddro_io1         (negedge SCK)) (1.2))
    
    (HOLD SO        (COND sdro_quad_io0_50 (posedge SCK)) (5))
    (HOLD SO        (COND ddro_quad_io0_50 (posedge SCK)) (5))
    (HOLD SO        (COND ddro_quad_io0_50 (negedge SCK)) (5))
    (HOLD SO        (COND sdro_quad_io0_51 (posedge SCK)) (2))
    (HOLD SO        (COND ddro_quad_io0_51 (posedge SCK)) (1.2))
    (HOLD SO        (COND ddro_quad_io0_51 (negedge SCK)) (1.2))
    
    (HOLD WPNeg     (COND sdro_quad_io2_50 (posedge SCK)) (5))
    (HOLD WPNeg     (COND ddro_quad_io2_50 (posedge SCK)) (5))
    (HOLD WPNeg     (COND ddro_quad_io2_50 (negedge SCK)) (5))
    (HOLD WPNeg     (COND sdro_quad_io2_51 (posedge SCK)) (2))
    (HOLD WPNeg     (COND ddro_quad_io2_51 (posedge SCK)) (1.2))
    (HOLD WPNeg     (COND ddro_quad_io2_51 (negedge SCK)) (1.2))
    
    (HOLD IO3_RESETNeg  (COND sdro_quad_io3_50 (posedge SCK)) (5))
    (HOLD IO3_RESETNeg  (COND ddro_quad_io3_50 (posedge SCK)) (5))
    (HOLD IO3_RESETNeg  (COND ddro_quad_io3_50 (negedge SCK)) (5))
    (HOLD IO3_RESETNeg  (COND sdro_quad_io3_51 (posedge SCK)) (2))
    (HOLD IO3_RESETNeg  (COND ddro_quad_io3_51 (posedge SCK)) (1.2))
    (HOLD IO3_RESETNeg  (COND ddro_quad_io3_51 (negedge SCK)) (1.2))

    (HOLD WPNeg  CSNeg        (20))
    (HOLD CSNeg  RESETNeg     (50))
    (HOLD CSNeg  IO3_RESETNeg (50))

    (WIDTH  (COND  rd        SCK)  (10))
    (WIDTH  (COND  fast_rd   SCK)   (3.01))
    (WIDTH  (COND  fast_rd1    SCK) (3.76))
    (WIDTH  (COND  ddrd      SCK)   (4.9))
    (WIDTH  (posedge CSNeg)       (10))
    (WIDTH  (COND  rst_quad  (posedge CSNeg)) (20))
    (WIDTH  (COND  RDYBSY       (posedge CSNeg)) (50))
    (WIDTH  (negedge RESETNeg)       (200))
    (WIDTH  (posedge RESETNeg)        (50))
    (WIDTH  (negedge IO3_RESETNeg)   (200))
    (WIDTH  (posedge IO3_RESETNeg)    (50))

    (PERIOD (COND rd SCK) (20))
    (PERIOD (COND fast_rd SCK) (6.02))
    (PERIOD (COND fast_rd1 SCK) (7.52))
    (PERIOD (COND ddrd SCK)   (9.8))
))
 (CELL
  (CELLTYPE "BUFFER")
  (INSTANCE dut/BUF_DOutZ)
  (DELAY (ABSOLUTE (DEVICE OUT (1.5)))))
 (CELL
  (CELLTYPE "BUFFER")
  (INSTANCE dut/BUF_DOut)
  (DELAY (ABSOLUTE (DEVICE OUT (2:4:8)))))
   (CELL
  (CELLTYPE "BUFFER")
  (INSTANCE dut/BUF_SEERC)
  (DELAY (ABSOLUTE (DEVICE OUT (55000:55000:60000))))
 )
 )